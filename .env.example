# ─────────────────────────────────────────────
# Second Self — environment configuration
# Copy this file to .env.local and fill in real values.
# NEVER commit real credentials.
# ─────────────────────────────────────────────

# --- Hindsight (Vectorize) ---------------------------------------------
# Base URL of your running Hindsight API instance
# (local docker default shown; point at a hosted instance if you have one)
HINDSIGHT_BASE_URL=http://localhost:8888

# LLM credentials used BY the Hindsight server itself for fact
# extraction / consolidation / reflect (configured on the Hindsight
# container, not read directly by this app — kept here for local dev
# convenience when running Hindsight via docker-compose).
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_API_KEY=

# Default memory bank id strategy — Second Self scopes one bank per user.
# This is a naming convention/prefix, not a secret.
HINDSIGHT_BANK_ID_PREFIX=second-self-user

# --- LLM provider used BY Second Self's own agent reasoning layer ------
# (separate from whatever LLM Hindsight itself is configured with)
AGENT_LLM_PROVIDER=groq
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Second Self
NODE_ENV=development
